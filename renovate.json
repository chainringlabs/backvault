{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tgrecojr/renovate-config"
  ],
  "ignoreDeps": [
    "ghcr.io/tgrecojr/backvault"
  ],
  "customManagers": [
    {
      "description": "rust-toolchain.toml pins the toolchain used by developers, CI, and releases",
      "customType": "regex",
      "managerFilePatterns": [
        "/^rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "channel = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Keep rust-toolchain.toml and the Rust builder image on one version in a single PR, so the image build and the developer toolchain never diverge (IMAGE-DEPS-004).",
      "matchDepNames": [
        "rust",
        "docker.io/library/rust"
      ],
      "groupName": "rust toolchain",
      "groupSlug": "rust-toolchain",
      "automerge": false
    }
  ]
}
